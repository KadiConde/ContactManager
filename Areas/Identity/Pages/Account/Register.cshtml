@page
@model RegisterModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <i class="bi bi-person-plus display-4 mb-2"></i>
                    <h2 class="fw-bold mb-0">Créer un profil</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <h5 class="text-center text-muted mb-4">Rejoignez la communauté ContactManager Pro</h5>
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nom@exemple.com" />
                            <label asp-for="Input.Email">Adresse courriel</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Mot de passe" />
                                    <label asp-for="Input.Password">Mot de passe</label>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmer" />
                                    <label asp-for="Input.ConfirmPassword">Confirmation</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill shadow-sm mt-3">
                            <i class="bi bi-rocket-takeoff me-2"></i>Créer mon compte
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>