<!DOCTYPE html>
<html lang="fr">
 @* Changé en 'fr' pour la cohérence du projet *@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ContactManager</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    @* --- STYLE --- *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Intégration des icônes Bootstrap demandées par le prof *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/ContactManager.styles.css" asp-append-version="true" />
  
</head>
<body>
    <header>
        @* Barre de navigation responsif avec thème sombre (plus professionnel) *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/favicon.svg" alt="Logo" width="30" height="30" class="me-2">ContactManager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Accueil
                            </a>
                        </li>

                        @* Section visible uniquement pour les utilisateurs authentifiés (Critère Autorisation) *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Contacts" asp-action="Index">
                                    <i class="bi bi-people"></i> Mes Contacts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-tags"></i> Catégories
                                </a>
                            </li>
                        }
                    </ul>
                    @* Gestion de la connexion/déconnexion *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @* Section principale où s'injectent les vues (Index, Create, etc.) *@
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    @* Pied de page personnalisé *@
    @*  <footer class="border-top footer text-muted bg-light">
        <div class="container text-center py-3">
            &copy; 2025 - <strong>ContactManager</strong> 
        </div>
    </footer>  *@

    @* --- SCRIPTS --- *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>