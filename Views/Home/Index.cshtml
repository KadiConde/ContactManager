@{
    ViewData["Title"] = "ContactManager Pro - Gestion de Contacts Intelligente";
}

<!-- Hero Section -->
<section id="home" class="hero-section d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row align-items-center">
            <!-- Hero Content -->
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="hero-content animate__animated animate__fadeInUp">
                    <span class="badge bg-primary-gradient rounded-pill px-3 py-2 mb-3 d-inline-block">
                        <i class="bi bi-star-fill me-1"></i> Solution Professionnelle
                    </span>

                    <h1 class="display-3 fw-bold mb-4">
                        Gérez Vos Contacts
                        <span class="text-primary">Intelligemment</span>
                    </h1>

                    <p class="lead mb-4">
                        ContactManager Pro est la solution ultime pour organiser, gérer et optimiser
                        vos contacts professionnels et personnels. Simple, sécurisé et accessible
                        depuis n'importe quel appareil.
                    </p>

                    <!-- Call to Action -->
                    <div class="d-flex flex-wrap gap-3 mt-5">
                        <a asp-area="Identity" asp-page="/Account/Register"
                           class="btn btn-primary btn-lg px-4 py-3 shadow-lg-hover animate__animated animate__pulse animate__infinite">
                            <i class="bi bi-rocket-takeoff me-2"></i>Commencer Gratuitement
                        </a>

                        <a href="#features" class="btn btn-outline-light btn-lg px-4 py-3">
                            <i class="bi bi-play-circle me-2"></i>Voir la Démo
                        </a>
                    </div>

                    <!-- Stats -->
                    <div class="row mt-5 pt-4">
                        <div class="col-4">
                            <div class="text-center">
                                <h3 class="fw-bold text-warning display-6">100%</h3>
                                <p class="text-light mb-0">Sécurisé</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center">
                                <h3 class="fw-bold text-warning display-6">24/7</h3>
                                <p class="text-light mb-0">Disponible</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center">
                                <h3 class="fw-bold text-warning display-6">∞</h3>
                                <p class="text-light mb-0">Contacts</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Image -->
            <div class="col-lg-6">
                <div class="hero-image position-relative">
                    <div class="floating-card card-1">
                        <i class="bi bi-person-badge text-primary fs-1"></i>
                        <h5 class="mt-2">Profils Complets</h5>
                    </div>
                    <div class="floating-card card-2">
                        <i class="bi bi-search text-success fs-1"></i>
                        <h5 class="mt-2">Recherche Avancée</h5>
                    </div>
                    <div class="floating-card card-3">
                        <i class="bi bi-shield-check text-danger fs-1"></i>
                        <h5 class="mt-2">100% Sécurisé</h5>
                    </div>
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                         alt="Dashboard Preview" class="img-fluid rounded-4 shadow-lg">
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
        <a href="#features" class="scroll-link">
            <i class="bi bi-chevron-down"></i>
        </a>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-success-gradient rounded-pill px-3 py-2 mb-2">
                <i class="bi bi-lightning-charge me-1"></i> Fonctionnalités
            </span>
            <h2 class="display-5 fw-bold mb-3">Tout ce dont vous avez besoin</h2>
            <p class="lead text-muted">Découvrez les fonctionnalités puissantes de ContactManager Pro</p>
        </div>

        <div class="row g-4">
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-primary-gradient rounded-circle mb-4">
                            <i class="bi bi-shield-lock fs-2"></i>
                        </div>
                        <h4 class="card-title fw-bold">Sécurité Maximale</h4>
                        <p class="card-text text-muted">
                            Authentification à deux facteurs, chiffrement des données et conformité RGPD.
                            Vos contacts sont en sécurité avec nous.
                        </p>
                        <ul class="list-unstyled text-muted">
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Chiffrement AES-256</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Authentification 2FA</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Backups quotidiens</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-warning-gradient rounded-circle mb-4">
                            <i class="bi bi-search-heart fs-2"></i>
                        </div>
                        <h4 class="card-title fw-bold">Recherche Intelligente</h4>
                        <p class="card-text text-muted">
                            Trouvez instantanément n'importe quel contact avec notre moteur de recherche avancé.
                            Filtrez par nom, ville, catégorie et plus.
                        </p>
                        <ul class="list-unstyled text-muted">
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Recherche en temps réel</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Filtres avancés</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Suggestions intelligentes</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <div class="feature-icon bg-info-gradient rounded-circle mb-4">
                            <i class="bi bi-phone-vibrate fs-2"></i>
                        </div>
                        <h4 class="card-title fw-bold">Responsive Design</h4>
                        <p class="card-text text-muted">
                            Accédez à vos contacts depuis n'importe quel appareil. Interface optimisée pour mobile,
                            tablette et desktop.
                        </p>
                        <ul class="list-unstyled text-muted">
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Design mobile-first</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Chargement rapide</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Interface tactile</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
