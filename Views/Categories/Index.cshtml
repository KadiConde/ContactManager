@model IEnumerable<ContactManager.Models.Categorie>

@{
    ViewData["Title"] = "Gestion des Catégories";
}

@* --- CONTENU PRINCIPAL --- *@
@* Note: Pas de class="container" ici car elle est déjà dans le _Layout *@
<div class="mt-4 animate__animated animate__fadeIn">

    @* --- EN-TÊTE DE LA SECTION --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark display-6">
                <i class="bi bi-tags-fill text-primary me-2"></i>@ViewData["Title"]
            </h1>
            <p class="text-muted mb-0">Organisez vos contacts par groupes logiques.</p>
        </div>

        @* Bouton d'ajout avec ombre et icône *@
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouvelle Catégorie
        </a>
    </div>

    @* --- LOGIQUE D'AFFICHAGE --- *@
    @if (!Model.Any())
    {
        @* Message convivial si la liste est vide *@
        <div class="alert alert-light border shadow-sm d-flex align-items-center rounded-3" role="alert">
            <div class="fs-1 text-primary me-3">
                <i class="bi bi-info-circle"></i>
            </div>
            <div>
                <h5 class="alert-heading fw-bold mb-1">C'est un peu vide ici !</h5>
                <p class="mb-0">Aucune catégorie n'a été créée. Cliquez sur le bouton vert pour commencer.</p>
            </div>
        </div>
    }
    else
    {
        @* Tableau stylisé dans une carte *@
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 text-muted small text-uppercase fw-bold">Liste des catégories existantes</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Nom de la catégorie</th>
                            <th class="text-end pe-4 py-3" style="min-width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border fs-6 fw-normal">
                                        <i class="bi bi-tag me-1 text-secondary"></i>@Html.DisplayFor(modelItem => item.Nom)
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.CategorieID"
                                           class="btn btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.CategorieID"
                                           class="btn btn-outline-info" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CategorieID"
                                           class="btn btn-outline-danger" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light py-2 text-center text-muted small">
                @Model.Count() catégorie(s) enregistrée(s)
            </div>
        </div>
    }
</div>