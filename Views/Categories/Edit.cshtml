@model ContactManager.Models.Categorie

@{
    ViewData["Title"] = "Modifier la Catégorie";
}

<div class="mt-4 animate__animated animate__fadeIn">
    @* --- EN-TÊTE --- *@
    <div class="mb-4 d-flex align-items-center justify-content-between">
        <div>
            <h1 class="fw-bold text-dark display-6">
                <i class="bi bi-pencil-square text-primary me-2"></i>Modifier la Catégorie
            </h1>
            <p class="text-muted mb-0">Renommez la catégorie <strong>"@Model.Nom"</strong> pour l'ensemble de vos contacts.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-5">
            @* --- CARTE DE FORMULAIRE --- *@
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        @* Champ caché pour l'ID *@
                        <input type="hidden" asp-for="CategorieID" />

                        <div class="form-group mb-4">
                            <label asp-for="Nom" class="form-label fw-bold small text-uppercase text-primary">Nouveau nom de la catégorie</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white border-primary-subtle">
                                    <i class="bi bi-tag text-primary"></i>
                                </span>
                                <input asp-for="Nom" class="form-control form-control-lg border-primary-subtle" placeholder="Ex: Professionnel" />
                            </div>
                            <span asp-validation-for="Nom" class="text-danger small"></span>
                        </div>

                        @* --- BOUTONS --- *@
                        <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check-lg me-2"></i>Enregistrer
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none">
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @* --- RAPPEL --- *@
            <div class="mt-4 p-3 bg-light rounded-3 border">
                <p class="small text-muted mb-0">
                    <i class="bi bi-exclamation-circle me-2 text-warning"></i>
                    <strong>Note :</strong> La modification du nom s'appliquera automatiquement à tous les contacts déjà liés à cette catégorie.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}