@model ContactManager.Models.Categorie

@{
    ViewData["Title"] = "Détails de la Catégorie";
}

<div class="mt-4 animate__animated animate__fadeIn">
    @* --- EN-TÊTE --- *@
    <div class="mb-4">
        <h1 class="fw-bold text-dark display-6">
            <i class="bi bi-info-circle text-info me-2"></i>Détails de la Catégorie
        </h1>
        <p class="text-muted">Consultez les informations relatives à cette classification de contacts.</p>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-5">
            @* --- CARTE DE DÉTAILS --- *@
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-tag-fill text-primary me-2"></i>Fiche Catégorie</h5>
                </div>
                <div class="card-body p-5 text-center">
                    @* Affichage du Nom en grand style "Badge" *@
                    <label class="text-muted small text-uppercase fw-bold d-block mb-3">Nom de la catégorie</label>
                    <div class="d-inline-block px-4 py-2 bg-info bg-opacity-10 border border-info rounded-pill text-info fs-3 fw-bold">
                        @Html.DisplayFor(model => model.Nom)
                    </div>
                </div>

                @* --- ACTIONS --- *@
                <div class="card-footer bg-light p-4">
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.CategorieID" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-pencil-square me-2"></i>Modifier
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-2"></i>Retour
                        </a>
                    </div>
                </div>
            </div>

            @* --- STATISTIQUES RAPIDES (Optionnel) --- *@
            <div class="mt-4 card border-0 shadow-sm bg-primary bg-gradient text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="mb-1 text-uppercase small opacity-75">Usage</h6>
                        <p class="mb-0 fs-5 fw-bold">ID de référence : #@Model.CategorieID</p>
                    </div>
                    <i class="bi bi-hash display-6 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>