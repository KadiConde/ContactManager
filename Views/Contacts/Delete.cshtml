@model ContactManager.Models.Contact

@{
    ViewData["Title"] = "Supprimer le contact";
}

<div class="mt-4 animate__animated animate__fadeIn">
    @* --- EN-TÊTE D'AVERTISSEMENT --- *@
    <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center p-4 mb-4">
        <i class="bi bi-exclamation-triangle-fill display-5 me-4"></i>
        <div>
            <h2 class="fw-bold mb-1">Confirmation de suppression</h2>
            <p class="mb-0">Êtes-vous certain de vouloir supprimer définitivement ce contact ? Cette action est irréversible.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            @* --- RÉCAPITULATIF DU CONTACT --- *@
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-person-x me-2"></i>Fiche du contact
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <tbody>
                            <tr>
                                <th class="ps-4 py-3 bg-light w-30">Nom complet</th>
                                <td class="py-3">@Model.Prenom @Model.Nom</td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light">Coordonnées</th>
                                <td class="py-3">
                                    <div class="mb-1"><i class="bi bi-envelope me-2 text-muted"></i>@Model.Courriel</div>
                                    <div><i class="bi bi-telephone me-2 text-muted"></i>@Model.Telephone</div>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light">Adresse</th>
                                <td class="py-3">
                                    @Model.Adresse, @Model.Ville (@Model.Province)<br />
                                    <span class="text-muted small">@Model.CodePostal</span>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light">Catégorie</th>
                                <td class="py-3">
                                    <span class="badge bg-info text-dark bg-opacity-25 border border-info">
                                        @Model.Categorie.Nom
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 py-3 bg-light">Date d'ajout</th>
                                <td class="py-3 text-muted">@Model.DateCreation.ToLongDateString()</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @* --- BOUTONS D'ACTION --- *@
                <div class="card-footer bg-light p-4 text-center">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ContactID" />

                        <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">
                            <i class="bi bi-trash me-2"></i>Confirmer la suppression
                        </button>

                        <div class="mt-3">
                            <a asp-action="Index" class="text-decoration-none text-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Annuler et retourner à la liste
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>